# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                     🏥 PharmaBroker Environment                               ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║  Copy this file to .env in the project root                                   ║
# ║  All apps will read from this single file                                     ║
# ║  ⚠️  DO NOT commit .env to version control!                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  🗄️  Database (PostgreSQL)                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

POSTGRES_DB=pharmabroker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmabroker


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ⚙️  Application                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘

NODE_ENV=development

# CORS origin for API (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Frontend API URL (required for Tauri - proxied through Vite)
VITE_SERVER_URL=http://localhost:5173


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  🔐 Authentication (Better Auth)                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# ⚠️  IMPORTANT: Change this to a random 32+ character string in production!
BETTER_AUTH_SECRET=super-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  📱 WhatsApp Integration                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# WhatsApp Go microservice URL (internal Docker network or localhost)
WHATSAPP_SERVICE_URL=http://localhost:8080

# WebSocket URL for real-time events from Go service
# Note: Use ws://whatsapp:8080/ws/events when running in Docker
# Use ws://localhost:8080/ws/events when running locally
WHATSAPP_WS_URL=ws://localhost:8080/ws/events

# API key for authenticating with Go service WebSocket
WHATSAPP_API_KEY=dev-api-key


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  🤖 AI Configuration                                                        │
# └─────────────────────────────────────────────────────────────────────────────┘

# AI Provider: gemini | ollama | openai | docker
# Default: docker (uses Docker Model Runner)
AI_PROVIDER=docker

# Gemini (Google AI Studio) - requires API key
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Ollama (local) - no API key required
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# OpenAI - requires API key
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Docker Model Runner (local Docker models) - no API key required
# Available models: ai/qwen3-vl, ai/ministral3, ai/gemma3
# IMPORTANT: Do NOT include :latest suffix in model names below
# Docker Model Runner handles versioning automatically
# Note: When using docker-compose with `models:` binding, these are auto-injected
# From containers: http://model-runner.docker.internal/engines/v1
# From host (TCP): http://localhost:12434/engines/v1
DOCKER_MODEL_BASE_URL=http://model-runner.docker.internal/engines/v1
DOCKER_MODEL_NAME=ai/qwen3-vl

# Embedding model configuration
EMBEDDING_PROVIDER=docker
EMBEDDING_MODEL_URL=http://model-runner.docker.internal/engines/v1
EMBEDDING_MODEL_NAME=ai/embeddinggemma


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  📋 Port Allocation Reference                                               │
# ├─────────────────┬───────┬───────────────────────────────────────────────────┤
# │  Service        │ Port  │ Notes                                             │
# ├─────────────────┼───────┼───────────────────────────────────────────────────┤
# │  PostgreSQL     │ 5432  │ Database                                          │
# │  API (Bun/Hono) │ 3000  │ Main API gateway                                  │
# │  WhatsApp (Go)  │ 8080  │ Internal only (Docker network)                    │
# │  Tauri/Web      │ 5173  │ Frontend dev server                               │
# └─────────────────┴───────┴───────────────────────────────────────────────────┘
