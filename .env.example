# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                     🏥 PharmaBroker Environment                               ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║  Copy this file to .env in the project root                                   ║
# ║  All apps will read from this single file                                     ║
# ║  ⚠️  DO NOT commit .env to version control!                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  🗄️  Database (PostgreSQL)                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

POSTGRES_DB=pharmabroker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmabroker


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ⚙️  Application                                                             │
# └─────────────────────────────────────────────────────────────────────────────┘

NODE_ENV=development

# CORS origin for API (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Frontend API URL (required for Tauri - proxied through Vite)
VITE_SERVER_URL=http://localhost:5173


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  🔐 Authentication (Better Auth)                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# ⚠️  IMPORTANT: Change this to a random 32+ character string in production!
BETTER_AUTH_SECRET=super-secret-key-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  📱 WhatsApp Integration                                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# WhatsApp Go microservice URL (internal Docker network or localhost)
WHATSAPP_SERVICE_URL=http://localhost:8080

# WebSocket URL for real-time events from Go service
# Note: Use ws://whatsapp:8080/ws/events when running in Docker
# Use ws://localhost:8080/ws/events when running locally
WHATSAPP_WS_URL=ws://localhost:8080/ws/events

# API key for authenticating with Go service WebSocket
WHATSAPP_API_KEY=dev-api-key


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  📋 Port Allocation Reference                                               │
# ├─────────────────┬───────┬───────────────────────────────────────────────────┤
# │  Service        │ Port  │ Notes                                             │
# ├─────────────────┼───────┼───────────────────────────────────────────────────┤
# │  PostgreSQL     │ 5432  │ Database                                          │
# │  API (Bun/Hono) │ 3000  │ Main API gateway                                  │
# │  WhatsApp (Go)  │ 8080  │ Internal only (Docker network)                    │
# │  Tauri/Web      │ 5173  │ Frontend dev server                               │
# └─────────────────┴───────┴───────────────────────────────────────────────────┘
