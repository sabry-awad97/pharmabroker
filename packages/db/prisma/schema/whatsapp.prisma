// WhatsApp Session Management
// Sessions are owned by the Node.js API and stored in PostgreSQL
// The Go WhatsApp service only handles connection state and message routing

model WhatsAppSession {
    id          String                @id @default(uuid())
    name        String
    jid         String? // WhatsApp JID (set after authentication)
    status      WhatsAppSessionStatus @default(pending)
    autoConnect Boolean               @default(false) @map("auto_connect") // Auto-reconnect on Go service startup
    userId      String
    user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt   DateTime              @default(now())
    updatedAt   DateTime              @updatedAt

    // Relations
    groups   WhatsAppGroup[]
    messages WhatsAppMessage[]

    @@index([userId])
    @@index([status])
    @@map("whatsapp_session")
}

enum WhatsAppSessionStatus {
    pending
    connecting
    connected
    disconnected
    logged_out
    expired

    @@map("whatsapp_session_status")
}

// WhatsApp Group Management
model WhatsAppGroup {
    id          String  @id @default(uuid())
    jid         String // Group JID (e.g., "123456789@g.us")
    name        String
    description String?
    avatarUrl   String? @map("avatar_url")

    // Group settings
    isAnnounce    Boolean @default(false) @map("is_announce") // Only admins can send messages
    isLocked      Boolean @default(false) @map("is_locked") // Only admins can edit group info
    isEphemeral   Boolean @default(false) @map("is_ephemeral") // Disappearing messages enabled
    ephemeralTime Int?    @map("ephemeral_time") // Disappearing messages duration in seconds

    // Ownership
    ownerJid  String?         @map("owner_jid") // Group creator JID
    sessionId String          @map("session_id")
    session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    // Filter support
    isArchived Boolean   @default(false) @map("is_archived") // Group is archived by user
    isMuted    Boolean   @default(false) @map("is_muted") // Group notifications are muted
    mutedUntil DateTime? @map("muted_until") // When mute expires (null = indefinite or not muted)

    // Metadata
    memberCount    Int       @default(0) @map("member_count")
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")
    groupCreatedAt DateTime? @map("group_created_at") // When the group was created on WhatsApp
    lastSyncAt     DateTime? @map("last_sync_at") // Last time group data was synced

    // Relations
    participants WhatsAppGroupParticipant[]
    messages     WhatsAppMessage[]

    @@unique([sessionId, jid])
    @@index([sessionId])
    @@index([jid])
    @@map("whatsapp_group")
}

// WhatsApp Group Participants
model WhatsAppGroupParticipant {
    id   String                       @id @default(uuid())
    jid  String // Participant JID (e.g., "1234567890@s.whatsapp.net")
    role WhatsAppGroupParticipantRole @default(member)

    // Participant info (cached from WhatsApp)
    displayName String? @map("display_name")
    avatarUrl   String? @map("avatar_url")

    // Group relation
    groupId String        @map("group_id")
    group   WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    // Metadata
    joinedAt  DateTime @default(now()) @map("joined_at")
    addedBy   String?  @map("added_by") // JID of who added this participant
    updatedAt DateTime @updatedAt @map("updated_at")

    // Relations
    messages WhatsAppMessage[]

    @@unique([groupId, jid])
    @@index([groupId])
    @@index([jid])
    @@map("whatsapp_group_participant")
}

enum WhatsAppGroupParticipantRole {
    member
    admin
    superadmin

    @@map("whatsapp_group_participant_role")
}

// ============================================================================
// WhatsApp Message - raw message storage with AI processing support
// ============================================================================

model WhatsAppMessage {
    id String @id @default(uuid())

    // Core identifier from WhatsApp
    messageId String @map("message_id") // WhatsApp message ID (e.g., "3EB0...")

    // Session relation (required)
    sessionId String          @map("session_id")
    session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    // Group context
    groupId String        @map("group_id")
    group   WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    // Sender - for group messages, links to participant
    senderJid      String                    @map("sender_jid") // Always store JID
    senderPushName String?                   @map("sender_push_name") // Cached at message time
    participantId  String?                   @map("participant_id")
    participant    WhatsAppGroupParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

    // Message type & content
    messageType WhatsAppMessageType @map("message_type")
    text        String? // Text content
    caption     String? // Media caption
    filename    String? // Document filename
    mimetype    String? // Media MIME type

    // Media references
    mediaUrl       String? @map("media_url")
    mediaKey       Bytes?  @map("media_key") // Encryption key
    mediaSha256    Bytes?  @map("media_sha256") // Hash for verification
    mediaSize      Int?    @map("media_size") // File size in bytes
    mediaLocalPath String? @map("media_local_path") // Local path if downloaded

    // Message flags
    isFromMe    Boolean @default(false) @map("is_from_me")
    isForwarded Boolean @default(false) @map("is_forwarded")
    isViewOnce  Boolean @default(false) @map("is_view_once")
    isBroadcast Boolean @default(false) @map("is_broadcast")

    // Reply context - self-referential for threading
    quotedMessageId String?           @map("quoted_message_id")
    quotedMessage   WhatsAppMessage?  @relation("MessageQuotes", fields: [quotedMessageId], references: [id], onDelete: SetNull)
    replies         WhatsAppMessage[] @relation("MessageQuotes")

    // Status tracking
    status WhatsAppMessageStatus @default(received)

    // Timestamps
    messageTimestamp DateTime @map("message_timestamp") // Original WhatsApp timestamp
    receivedAt       DateTime @default(now()) @map("received_at")

    // Source tracking
    source WhatsAppMessageSource @default(realtime)

    // Raw data preservation
    rawPayload Json? @map("raw_payload")

    // -------------------------------------------------------------------------
    // AI Processing Fields
    // -------------------------------------------------------------------------
    
    // Processing status
    aiStatus      WhatsAppAIStatus @default(pending) @map("ai_status")
    aiProcessedAt DateTime?        @map("ai_processed_at")
    aiModel       String?          @map("ai_model") // Model used (e.g., "gpt-4o", "claude-3")
    aiError       String?          @map("ai_error") // Error message if failed
    aiRetryCount  Int              @default(0) @map("ai_retry_count")

    // Relations
    extractedData WhatsAppExtractedData[]

    @@unique([sessionId, messageId])
    @@index([sessionId])
    @@index([groupId])
    @@index([participantId])
    @@index([senderJid])
    @@index([messageTimestamp])
    @@index([source])
    @@index([aiStatus])
    @@map("whatsapp_message")
}

// ============================================================================
// WhatsApp Extracted Data - AI-extracted structured data from messages
// ============================================================================

model WhatsAppExtractedData {
    id String @id @default(uuid())

    // Message relation
    messageId String          @map("message_id")
    message   WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    // Extraction type (flexible string for different use cases)
    dataType String @map("data_type")

    // Structured data (flexible JSON for different extraction types)
    data Json // The extracted structured data

    // AI metadata
    confidence Float?  @default(0) // Confidence score 0-1
    model      String? // Model that extracted this
    promptHash String? @map("prompt_hash") // Hash of prompt used (for versioning)

    // Metadata
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([messageId])
    @@index([dataType])
    @@index([confidence])
    @@map("whatsapp_extracted_data")
}

// ============================================================================
// Enums
// ============================================================================

enum WhatsAppMessageType {
    text
    image
    video
    audio
    document
    sticker
    contact
    location
    poll
    reaction
    protocol // System messages (group changes, etc.)
    unknown

    @@map("whatsapp_message_type")
}

enum WhatsAppMessageStatus {
    received
    sent
    delivered
    read
    failed

    @@map("whatsapp_message_status")
}

enum WhatsAppMessageSource {
    realtime
    history

    @@map("whatsapp_message_source")
}

enum WhatsAppAIStatus {
    pending    // Not yet processed
    processing // Currently being processed
    completed  // Successfully processed
    failed     // Processing failed
    skipped    // Skipped (e.g., media-only, system message)

    @@map("whatsapp_ai_status")
}
