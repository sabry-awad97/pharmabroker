{
  "name": "@pharmabroker/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "db:push": "prisma db push --schema=prisma/schema",
    "db:generate": "prisma generate --schema=prisma/schema",
    "db:migrate": "prisma migrate dev --schema=prisma/schema",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@pharmabroker/env": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pharmabroker/config": "workspace:*",
    "@types/pg": "^8.15.6",
    "prisma": "^7.1.0",
    "typescript": "catalog:"
  }
}
